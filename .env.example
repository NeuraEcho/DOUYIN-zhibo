# ============================================================
# AI 云端口播直播系统 - 环境变量配置模板
# 用法：copy .env.example .env  然后填入实际值
#
# 说明：
# - 所有值都有代码内默认值（见 config/settings.py），只填你要改的即可
# - 三家 TTS 引擎任选其一，未用到的把 Key 留空即可，不影响启动
# - 改本文件后必须重启 python main.py 才生效
#   （后台页面上改的配置是热更新的，重启会回落到这里的默认值）
# ============================================================


# ========== LLM：DeepSeek ==========
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.openai-proxy.org/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TIMEOUT=120


# ========== TTS 引擎 1：MiniMax Speech-2.8-Turbo ==========
# 特点：支持 (breath)/(chuckle) 等 19 种口语化标注，支持在本项目后台内直接做声音克隆
SPEECH_API_KEY=sk-xxxx
SPEECH_MODEL=speech-2.8-turbo
SPEECH_VOICE=female-shaonv
SPEECH_SPEED=0.92
SPEECH_PITCH=-1
SPEECH_EMOTION=happy
SPEECH_SAMPLE_RATE=24000


# ========== TTS 引擎 2：火山引擎 Seed-TTS 2.0（V3 双向流式 WebSocket）==========
# 鉴权走 X-Api-Key + X-Api-Resource-Id 请求头；真正生效的是 api_key，app_id 仅为兼容字段
# ⚠️ 音色与 resource_id 必须匹配：预置音色走 seed-tts-2.0，S_ 开头的克隆音色走 seed-icl-2.0，
#    不匹配会报 code=55000000 "resource ID is mismatched with speaker related resource"
VOLCENGINE_API_KEY=xxxx
VOLCENGINE_APP_ID=
VOLCENGINE_CLUSTER=volcano_tts
VOLCENGINE_VOICE_TYPE=BV001_streaming
VOLCENGINE_ENCODING=pcm
VOLCENGINE_SAMPLE_RATE=24000
VOLCENGINE_SPEED_RATIO=1.0
VOLCENGINE_VOLUME_RATIO=1.0
VOLCENGINE_PITCH_RATIO=1.0
# expressive 支持情绪控制（整体情绪 context_texts），standard 不支持
VOLCENGINE_MODEL=seed-tts-2.0-expressive
VOLCENGINE_EMOTION_ENABLED=true
# 整体情绪 / 全局语音指令（预置音色与复刻 2.0 音色均生效），可在后台「配置管理」热更新
VOLCENGINE_CONTEXT_TEXT=专业电商主播，情绪自然起伏，口语松弛，真人直播节奏，不要机器感，不要播音腔
# 分片之间的静音间隔秒数（模拟真人换气），0 表示关闭
VOLCENGINE_BLOCK_GAP=0.3


# ========== TTS 引擎 3：ElevenLabs ==========
# API Key 在 https://elevenlabs.io/app/settings/api-keys 创建；鉴权走 xi-api-key 请求头，不是 Bearer
ELEVENLABS_API_KEY=
# 接口地址：国内直连 api.elevenlabs.io 常超时，不通时改成你自己的中转地址
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# 默认音色 ID（下面是官方预置的 Rachel）；建议在后台「音色克隆」页在线选，此处仅为兜底
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM
# 模型：中文必须 eleven_multilingual_v2 或 eleven_flash_v2_5
#   eleven_multilingual_v2 - 长文本最稳定，10000 字符上限，延迟较高，1 credit/字符
#   eleven_flash_v2_5      - 延迟约 75ms，40000 字符上限，价格只要一半，并发额度翻倍（直播推荐）
#   eleven_v3              - 表现力最强，5000 字符上限，延迟最高，官方明确不面向实时应用
#   eleven_turbo_v2_5      - 已废弃，官方建议改用 flash_v2_5
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ⚠️ 输出格式只能是 pcm_*：AudioPlayer 按 16-bit 单声道裸 PCM 消费，mp3/opus 会变成噪声
# pcm_44100 需 ElevenLabs Pro 及以上套餐，pcm_24000 无门槛且与 AUDIO_SAMPLE_RATE 一致
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
# ISO 639-1 语言码；multilingual_v2 不支持此参数，保持留空
ELEVENLABS_LANGUAGE_CODE=
# voice_settings（0-1）：stability 略低情绪起伏更自然；style>0 会明显增加延迟，直播建议保持 0
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=true
ELEVENLABS_SPEED=0.95
# auto / on / off；注意 flash_v2_5 的数字规范化需 Enterprise 套餐才能开 "on"
# （本项目已在 tts_synthesize 里做数字转中文预处理，所以选 flash 也不会读错价格）
ELEVENLABS_APPLY_TEXT_NORMALIZATION=auto
ELEVENLABS_TIMEOUT=60
ELEVENLABS_CONNECT_TIMEOUT=10
# 429 限流 / 5xx / 网络抖动的重试次数
ELEVENLABS_MAX_RETRIES=2
# 注：ELEVENLABS_SAMPLE_RATE 无需配置，由 ELEVENLABS_OUTPUT_FORMAT 自动推导


# ========== Web 管理后台 ==========
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=false


# ========== 直播间 / 弹幕源（无前缀）==========
# 抖音直播间号；可在后台「配置管理」热更新，改完自动用新房间号重连，无需重启
ROOM_ID=your_room_id
PLATFORM_API_KEY=
# 弹幕源 WebSocket 地址。留空或不含 /ws/ 时会自动拼成 {base}/ws/{ROOM_ID}
#   抖音：douyinLive 本地服务，如 ws://127.0.0.1:8080
#   视频号：wxlivespy 走 HTTP 转发到本服务的 /forward，此项留空即可
PLATFORM_WS_URL=ws://127.0.0.1:8080


# ========== 音频输出 ==========
# ⚠️ 采样率契约：AUDIO_SAMPLE_RATE 必须与当前 TTS 引擎的输出采样率一致，否则播放变调变速
AUDIO_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
AUDIO_BUFFER_SIZE=1024
# VB-Audio Virtual Cable 装好后 Windows 声音设置里出现的设备名
VIRTUAL_SOUND_CARD_NAME=CABLE Input (VB-Audio Virtual Cable)


# ========== LangGraph 编排层（无前缀）==========
CHECKPOINT_DIR=./checkpoints
# 对话上下文窗口大小（保留最近 N 轮消息）
CONTEXT_WINDOW_SIZE=10


# ========== 弹幕打断过滤 ==========
# 弹幕包含任一关键词才触发问答，逗号分隔；也可在后台「配置管理」热更新
DANMAKU_INTERRUPT_KEYWORDS=问一下,多少钱,怎么样,打断,这个,好不好,能用多久,什么时候
# 打断冷却秒数，防止刷屏频繁打断
DANMAKU_COOLDOWN_SECONDS=3.0
# 忽略字数少于此值的弹幕
DANMAKU_MIN_TEXT_LENGTH=2


# ========== OBS 推流控制（obs-websocket v5，OBS 28+ 内置）==========
# 总开关：false 时后台 OBS 卡片提示未启用、接口直接拒绝
OBS_ENABLED=true
OBS_HOST=127.0.0.1
OBS_PORT=4455
# OBS「工具 → obs-websocket 设置」里的服务器密码；未开鉴权留空
OBS_PASSWORD=
OBS_TIMEOUT=8.0
# 直播伴侣发的是自定义推流地址，固定 rtmp_custom
OBS_STREAM_SERVICE_TYPE=rtmp_custom


# ========== 预就绪伺机插入式打断续播 ==========
# 脚本播报中收到弹幕提问：不打断，后台静默预生成回答，就绪后在句尾插入，播完续读脚本
# 总开关：false 时回退旧的即时打断行为
QA_ENABLED=true
# 问答预生成最大超时秒数（超时静默丢弃）
QA_PREGEN_TIMEOUT_SECONDS=15.0
# 回答就绪后最大允许跳过的脚本分句数（超限则作废，避免答非所问）
QA_MAX_SKIP_SENTENCES=3
# 脚本合成领先播放的预缓冲句数
QA_PREBUFFER_SENTENCES=1
# 回答与续读脚本之间的静音间隔秒数
QA_ANSWER_TRAILING_GAP_SECONDS=0.25


# ========== 日志 ==========
LOG_LEVEL=INFO
LOG_FILE=./logs/live.log


# ========== 主播人设 Prompt（可选）==========
# 不配置则使用 config/settings.py 里的 default_system_prompt（抖音带货主播口语化话术规则）
# 也可在后台「配置管理」直接编辑，那里是热更新的，推荐用后台改而不是改这里
# DEFAULT_SYSTEM_PROMPT=你是抖音带货主播，输出口语化直播话术...
