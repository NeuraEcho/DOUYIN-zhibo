# ============================================
# AI 云端口播直播系统 - 环境变量配置模板
# 复制为 .env 后填写实际值
# ============================================

# ---------- DeepSeek-V4-Flash 配置 ----------
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.openai-proxy.org/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TIMEOUT=120

# ---------- Speech-2.8-Turbo TTS 配置（MiniMax 原生 API） ----------
SPEECH_API_KEY=sk-xxxx
SPEECH_MODEL=speech-2.8-turbo
SPEECH_VOICE=speech-2.8-turbo
SPEECH_SPEED=1.0
SPEECH_SAMPLE_RATE=24000

# ---------- Web 服务配置 ----------
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_DEBUG=false

# ---------- 直播间配置 ----------
ROOM_ID=your_room_id
PLATFORM_API_KEY=your_platform_api_key
PLATFORM_WS_URL=wss://your-platform.com/danmaku

# ---------- 音频输出配置 ----------
VIRTUAL_SOUND_CARD_NAME=CABLE Input (VB-Audio Virtual Cable)
AUDIO_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
AUDIO_BUFFER_SIZE=1024

# ---------- LangGraph 配置 ----------
CHECKPOINT_DIR=./checkpoints
CONTEXT_WINDOW_SIZE=10

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_FILE=./logs/live.log
